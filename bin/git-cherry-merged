#!/bin/sh

upstream=origin

while test "$#" -gt 0
do
  case "$1" in
  --upstream)
    upstream="$2"
    shift 2
    ;;
  --upstream=*)
    upstream="${1#--upstream=}"
    shift
    ;;
  *)
    break;
    ;;
  esac
done

git for-each-ref --format='%(refname)' "$@" |
while read topic
do
  git cherry $upstream $topic | grep -qv '^-' || echo $topic
done
