#!/usr/bin/env bash

set -e

if [ 1 -ne $# ]; then
  echo >&2 "fatal: expected lore.kernel.org URL, aborting ..."
  exit 1
fi

mbox="$(mktemp /tmp/git-lore.mbox.XXXXXX)"
trap "rm -f $mbox" EXIT

url="$(echo "$1" | sed -e 's/\/T\/.*//' | sed -e 's/\/$//')"

curl -Ss "$url/t.mbox.gz" | gunzip >$mbox
mutt -f $mbox -e "push '<search>~i $(basename "$url")<enter>'" -F <(cat <<-EOF
  source ~/.mutt/base

  set from = "me@ttaylorr.com"
  set sendmail="/usr/local/bin/msmtp -a ttaylorr.com"

  set postponed=$mbox
EOF
)
